# paper-figure 配置模板
# 用法：复制为工作区根目录的 .env（或写进 AGENTS.md 的同名条目），或直接设成同名环境变量。
# 优先级：环境变量 > .env > 下表默认值。

# 图内文字语种：zh = 全中文（中文论文/国赛）| en = 全英文（英文论文/美赛）
# 一张图内不许中英混排（LSTM、SEIR 这类术语缩写除外）。
PF_FIG_LANG=zh

# 产出目录（相对工作区根目录）：svg / png / html 三件套都落在这里
PF_OUT_DIR=figures

# PNG 缩放倍数：1600x900 画布 x2 = 3200x1800（约 300dpi 投稿级）
PF_SCALE=2
